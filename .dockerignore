# Ignore Python cache files
__pycache__
*.pyc
*.pyo

# Ignore any virtual environment directories
venv/
env/
ENV/
.venv/

# Ignore log files
*.log

# Ignore Docker-related files
Dockerfile
docker-compose*.yml

# Ignore Git files
.git
.gitignore

.github
tests/

# Host-only onboarding. The running image does not need it.
setup.py
pmp-setup.py

# Never bake live history into the image
logs/
pickmypostcode_logs/

# Local debug captures
*screenshot*
*.har

# Ignore IDE/editor specific files
.vscode/
*.swp
*.swo

# Ignore sensitive configuration files
.env
.env.*

*.md
*.example
